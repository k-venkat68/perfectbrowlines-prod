# dotenv reads .env, not .env.example. Copy this file to .env, then set MONGODB_URI there.
# Never put real credentials in this example file or commit .env.

# MongoDB Atlas connection string. Replace all placeholders with your Atlas values.
# In Atlas Network Access, allow only the app server's IP address.
# URL-encode special characters in the database username and password.
MONGODB_URI="mongodb+srv://myadmin:Sun123123@<cluster-host>/<database>?retryWrites=true&w=majority"

